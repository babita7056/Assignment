# PassportWatch — Environment Variables
# Copy this file to .env and fill in your values

# Required — PostgreSQL connection string
# Local example:  postgresql://postgres:password@localhost:5432/passportwatch
# Neon example:   postgresql://user:pass@ep-xxx.us-east-1.aws.neon.tech/passportwatch?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/passportwatch

# Required for AI summaries — get your key at https://platform.openai.com/api-keys
# If omitted, summaries will fall back to truncated post text (all other features still work)
OPENAI_API_KEY=sk-...

# Required — any long random string (32+ chars) used to sign sessions
SESSION_SECRET=change_this_to_a_long_random_secret_string_in_production
